# .env.example — ringkasan semua konfigurasi. JANGAN commit nilai asli.

# =====================================================================
# BACKEND API (Next.js) — apps/api/.env.local  (atau Environment Variables di Vercel)
# =====================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Rahasia! Hanya di server. Dipakai tools AI & pembuatan user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Opsional — default claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5
# Origin web admin yang boleh memanggil API (pisahkan koma). "*" = semua.
CORS_ALLOWED_ORIGINS=*

# =====================================================================
# FLUTTER (mobile kasir & web admin) — apps/mobile/env.json dan apps/admin/env.json
# Dipakai via: flutter run --dart-define-from-file=env.json
# =====================================================================
# {
#   "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
#   "SUPABASE_ANON_KEY": "your-anon-public-key",
#   "API_BASE_URL": "https://your-api.vercel.app"
# }
