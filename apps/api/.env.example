# apps/api/.env.example — salin ke apps/api/.env.local
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Rahasia! Hanya di server. Dipakai tools AI & pembuatan user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Opsional — default claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5
# Origin Flutter Web admin yang boleh memanggil API, pisahkan dengan koma. "*" = semua.
CORS_ALLOWED_ORIGINS=*
# Midtrans QRIS dinamis — server key dari dashboard.sandbox.midtrans.com → Settings → Access Keys.
# Rahasia! Hanya di server. Set MIDTRANS_IS_PRODUCTION=true hanya dengan key produksi.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
