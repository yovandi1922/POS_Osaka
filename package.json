{
  "name": "coffee-pos",
  "version": "2.0.0",
  "private": true,
  "description": "Coffee Shop POS & Smart Assistant — Flutter (mobile kasir + web admin) + Next.js API + Supabase",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @coffee-pos/api dev",
    "build:api": "pnpm --filter @coffee-pos/api build",
    "start:api": "pnpm --filter @coffee-pos/api start",
    "typecheck": "pnpm -r typecheck",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  }
}
